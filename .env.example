# Copy to .env.local for local development.
# DATABASE_URL and BLOB_READ_WRITE_TOKEN are OPTIONAL locally: with neither set,
# the app stores data in ./.data/*.json and keeps photos as data URLs, so
# `npm run dev` works with zero setup.

# --- Access (SET THIS BEFORE SHARING THE SITE) ----------------------------
# Shared passphrase for the private areas: album, diary, letters, mixtape, bingo.
# Friends writing a letter at /write never need it.
#
# If this is EMPTY, there is NO protection and every page is public — the app
# shows a red banner saying so. Never deploy without it.
RIJUKO_PASSPHRASE=

# Extra signing salt for the session cookie. Any long random string.
# Changing it (or the passphrase) logs everyone out.
RIJUKO_SECRET=

# --- Database -------------------------------------------------------------
# Vercel Dashboard -> Storage -> Neon Postgres. Injected automatically on Vercel.
DATABASE_URL=

# --- Photo storage --------------------------------------------------------
# Vercel Dashboard -> Storage -> Blob. Injected automatically on Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Cosmetic -------------------------------------------------------------
# Her name, shown on the home page.
NEXT_PUBLIC_HER_NAME=Riju
